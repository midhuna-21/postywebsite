4:[["$","$Lf",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"NewsArticle\",\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://www.pressorahub.com/enterprise/kauai-ag-land-sale-hawaii-food-initiative/\"},\"headline\":\"Billionaire Seeks to Sell Kaua‘i Ag Land as Hawaii Eyes Local Food Initiatives\",\"description\":\"A Kaua‘i billionaire is looking to sell over 1,000 acres of prime agricultural land, with Hawaii’s state Agribusiness Development Corp. considering the purchase to boost local food production.\",\"image\":\"/images/kauai-ag-land-sale.webp\",\"author\":{\"@type\":\"Person\",\"name\":\"Lauren Jacobs\",\"url\":\"https://www.pressorahub.com/our-team/\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"PressoraHub\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://www.pressorahub.com/images/pressorahub-icon.webp\"}},\"datePublished\":\"2025-06-18T00:00:00.000Z\",\"dateModified\":\"2025-06-18T00:00:00.000Z\"}"}}],["$","$L10",null,{"breadcrumbTitle":"Billionaire Seeks to Sell Kaua‘i Ag Land as Hawaii Eyes Local Food Initiatives","category":"enterprise","children":["$","div",null,{"children":[["$","section",null,{"className":"post-layout-1 padding","children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"top-content","children":[["$","div",null,{"className":"post-card single-card","children":["$","div",null,{"className":"post-content","children":[["$","$L11",null,{"title":"kauai-ag-land-sale-hawaii-food-initiative","href":"/enterprise","className":"card-btn bg-green","children":"enterprise"}],["$","h1",null,{"className":"title","style":{"lineHeight":1.3},"children":"Billionaire Seeks to Sell Kaua‘i Ag Land as Hawaii Eyes Local Food Initiatives"}],["$","ul",null,{"className":"post-list","children":[["$","li",null,{"className":"author","children":["by ",["$","span",null,{"children":"Lauren Jacobs"}]]}],["$","li",null,{"className":"date","children":"October 9, 2025"}]]}],["$","p",null,{"children":"A Kaua‘i billionaire is looking to sell over 1,000 acres of prime agricultural land, with Hawaii’s state Agribusiness Development Corp. considering the purchase to boost local food production."}]]}]}],["$","div",null,{"className":"post-social","children":["$","ul",null,{"className":"social-list d-flex align-items-center","children":[["$","li",null,{}],["$","li",null,{"children":["$","$L11",null,{"href":"https://www.instagram.com/laur.enjacobs001/","className":"instagram","children":["$","i",null,{"className":"lab la-instagram"}]}]}],["$","li",null,{"children":["$","$L11",null,{"href":"https://medium.com/@lauren_jacobs","className":"","style":{"border":""},"children":["$","i",null,{"className":"lab la-medium"}]}]}],["$","li",null,{"children":["$","$L11",null,{"href":"https://substack.com/@laurenjacobs672308","className":"pinterest","children":["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":"20","height":"15","viewBox":"0 0 256 256","children":["$","g",null,{"transform":"scale(5.12,5.12)","children":[["$","path",null,{"d":"M43,11h-35v-6h35z"}],["$","path",null,{"d":"M43,19h-35v-6h35z"}],["$","path",null,{"d":"M43,44.805l-17.016,-10.636l-17.984,10.579v-23.748h35z"}]]}]}]}]}]]}]}]]}],["$","div",null,{"className":"row","children":[["$","div",null,{"className":"col-lg-8","children":["$","div",null,{"className":"post-layout-content","children":[["$","div",null,{"className":"layout-thumb mb-30","children":["$","$L12",null,{"title":"Billionaire Seeks to Sell Kaua‘i Ag Land as Hawaii Eyes Local Food Initiatives","src":"/images/kauai-ag-land-sale.webp","alt":"Billionaire Seeks to Sell Kaua‘i Ag Land as Hawaii Eyes Local Food Initiatives","width":1200,"height":800,"priority":true,"style":{"width":"100%","height":"auto"}}]}],["$","div",null,{"children":[["$","p","0",{"className":"layout-desc","style":{"marginBottom":"1rem"},"children":"Over 1,000 acres of Kaua‘i plantation land, owned by a prominent billionaire tech entrepreneur, are potentially changing hands as Hawaii’s state Agribusiness Development Corp.  considers purchasing the property.  This initiative aligns with the state’s broader strategy to strengthen local food production, advance agricultural sustainability, and reduce reliance on imported food.  Experts highlight that the sale could significantly benefit Hawai‘i’s local food system by providing prime agricultural land for community-supported agriculture (CSA) programs, farm-to-table initiatives, and other locally focused food projects.  The acquisition represents a collaboration between private investment and public policy aimed at addressing long-term food security challenges."}],"$L13","$L14","$L15"]}],"$L16","$L17"]}]}],"$L18"]}]]}]}],"$L19"]}]}]]
