4:[["$","$Lf",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"NewsArticle\",\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://www.pressorahub.com/us/massachusetts-plane-crash-interstate-195/\"},\"headline\":\"Plane crashes onto a Massachusetts highway, killing 2 on board and hurting 1 motorist\",\"description\":\"A small plane crashed onto Massachusetts’ Interstate 195 during Monday morning rush hour, killing both passengers onboard. Flaming debris scattered across the highway, but no motorists were seriously injured. Authorities are investigating the cause amid rainy, windy conditions from a nor’easter.\",\"image\":\"/images/massachusetts-plane-crash.webp\",\"author\":{\"@type\":\"Person\",\"name\":\"Lauren Jacobs\",\"url\":\"https://www.pressorahub.com/our-team/\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"PressoraHub\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://www.pressorahub.com/images/pressorahub-icon.webp\"}},\"datePublished\":\"2025-06-18T00:00:00.000Z\",\"dateModified\":\"2025-06-18T00:00:00.000Z\"}"}}],["$","$L10",null,{"breadcrumbTitle":"Plane crashes onto a Massachusetts highway, killing 2 on board and hurting 1 motorist","category":"us","children":["$","div",null,{"children":[["$","section",null,{"className":"post-layout-1 padding","children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"top-content","children":[["$","div",null,{"className":"post-card single-card","children":["$","div",null,{"className":"post-content","children":[["$","$L11",null,{"title":"massachusetts-plane-crash-interstate-195","href":"/us","className":"card-btn bg-green","children":"us"}],["$","h1",null,{"className":"title","style":{"lineHeight":1.3},"children":"Plane crashes onto a Massachusetts highway, killing 2 on board and hurting 1 motorist"}],["$","ul",null,{"className":"post-list","children":[["$","li",null,{"className":"author","chi