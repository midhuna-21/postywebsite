4:[["$","$Lf",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"NewsArticle\",\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://www.pressorahub.com/us/blank-foundation-hbcu-scholarships/\"},\"headline\":\"Arthur M. Blank Family Foundation donating $50 million to historically Black Atlanta colleges\",\"description\":\"The Arthur M. Blank Family Foundation donated $50 million to Atlanta’s HBCUs to provide gap scholarships for nearly 10,000 students, helping boost graduation rates and support those with financial need.\",\"image\":\"/images/blank-hbcu-scholarships.webp\",\"author\":{\"@type\":\"Person\",\"name\":\"David Miller\",\"url\":\"https://www.pressorahub.com/our-team/\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"PressoraHub\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://www.pressorahub.com/images/pressorahub-icon.webp\"}},\"datePublished\":\"2025-06-18T00:00:00.000Z\",\"dateModified\":\"2025-06-18T00:00:00.000Z\"}"}}],["$","$L10",null,{"breadcrumbTitle":"Arthur M. Blank Family Foundation donating $50 million to historically Black Atlanta colleges","category":"us","children":["$","div",null,{"children":[["$","section",null,{"className":"post-layout-1 padding","children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"top-content","children":[["$","div",null,{"className":"post-card single-card","children":["$","div",null,{"className":"post-content","children":[["$","$L11",null,{"title":"blank-foundation-hbcu-scholarships","href":"/us","className":"card-btn bg-green","children":"us"}],["$","h1",null,{"className":"title","style":{"lineHeight":1.3},"children":"Arthur M. Blank Family Foundation donating $50 million to historically Black Atlanta colleges"}],["$","ul",null,{"className":"post-list","children":[["$","li",null,{"className":"author","children":["by ",["$","span",null,{"children":"David Miller"}]]}],["$","li",null,{"class