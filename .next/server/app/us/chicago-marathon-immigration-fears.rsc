8:{"metadata":[["$","title","0",{"children":"Immigration crackdown stirs unease ahead of this weekend’s Chicago Marathon"}],["$","meta","1",{"name":"description","content":"Runners at the Chicago Marathon are taking extra precautions amid fears of immigration enforcement, with participants from Hispanic and other minority backgrounds worried about potential ICE targeting. Officials, including ICE and the mayor, say there is no planned enforcement, but the concerns have affected local businesses and community participation"}],["$","meta","2",{"name":"author","content":"Lauren Jacobs"}],["$","meta","3",{"name":"keywords","content":"us, news, Immigration crackdown stirs unease ahead of this weekend’s Chicago Marathon"}],["$","meta","4",{"name":"script:ld+json","content":"{\"@context\":\"https://schema.org\",\"@type\":\"NewsArticle\",\"headline\":\"Immigration crackdown stirs unease ahead of this weekend’s Chicago Marathon\",\"datePublished\":\"October 11, 2025\",\"author\":{\"@type\":\"Person\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"PressoraHub\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://www.pressorahub.com/pressorahub-icon.webp\"}},\"image\":\"https://www.pressorahub.com/images/chicago-marathon-2025.webp\",\"url\":\"https://www.pressorahub.com/us/chicago-marathon-immigration-fears\",\"articleBody\":\"Michael Guidotti will have his driver’s license on him when he runs the Chicago Marathon, just as he did during every training run since summer. After the Trump\",\"keywords\":\"us, news\"}"}],["$","link","5",{"rel":"canonical","href":"https://www.pressorahub.com/us/chicago-marathon-immigration-fears"}],["$","meta","6",{"property":"og:title","content":"Immigration crackdown stirs unease ahead of this weekend’s Chicago Marathon"}],["$","meta","7",{"property":"og:description","content":"Runners at the Chicago Marathon are taking extra precautions amid fears of immigration enforcement, with participants from Hispanic and other minority backgrounds 