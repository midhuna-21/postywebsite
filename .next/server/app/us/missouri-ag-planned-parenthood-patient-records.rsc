10:T430,{"@context":"https://schema.org","@type":"NewsArticle","mainEntityOfPage":{"@type":"WebPage","@id":"https://www.pressorahub.com/us/missouri-ag-planned-parenthood-patient-records/"},"headline":"Abortion providers say Missouri’s attorney general is trying to get patient records","description":"Missouri’s Republican attorney general is seeking Planned Parenthood patient records in a legal battle over the state’s abortion restrictions, which clinics argue violate a voter-approved constitutional amendment protecting abortion rights. Planned Parenthood calls the subpoenas an invasion of patient privacy as the lawsuit over Missouri’s abortion laws continues.","image":"/images/missouri-planned-parenthood-records-lawsuit.webp","author":{"@type":"Person","name":"Lauren Jacobs","url":"https://www.pressorahub.com/our-team/"},"publisher":{"@type":"Organization","name":"PressoraHub","logo":{"@type":"ImageObject","url":"https://www.pressorahub.com/images/pressorahub-icon.webp"}},"datePublished":"2025-06-18T00:00:00.000Z","dateModified":"2025-06-18T00:00:00.000Z"}4:[["$","$Lf",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],["$","$L11",null,{"breadcrumbTitle":"Abortion providers say Missouri’s attorney general is trying to get patient records","category":"us","children":["$","div",null,{"children":[["$","section",null,{"className":"post-layout-1 padding","children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"top-content","children":[["$","div",null,{"className":"post-card single-card","children":["$","div",null,{"className":"post-content","children":[["$","$L12",null,{"title":"missouri-ag-planned-parenthood-patient-records","href":"/us","className":"card-btn bg-green","children":"us"}],["$","h1",null,{"className":"title","style":{"lineHeight":1.3},"children":"Abortion providers say Missouri’s attorney general is trying to get patient records"}],["$","ul",null,{"className":"post-list","children":[["$","li