8:{"metadata":[["$","title","0",{"children":"Trump administration puts on hold $18 billion in funding for New York City infrastructure projects"}],["$","meta","1",{"name":"description","content":"The Trump administration paused roughly $18 billion in funding for the Hudson River rail tunnel and the Second Avenue subway extension in New York City due to the federal government shutdown, citing concerns over “unconstitutional” diversity and equity policies. Officials warn the halt threatens jobs, commuters, and major infrastructure projects."}],["$","meta","2",{"name":"author","content":"David Miller"}],["$","meta","3",{"name":"keywords","content":"us, news, Trump administration puts on hold $18 billion in funding for New York City infrastructure projects"}],["$","meta","4",{"name":"script:ld+json","content":"{\"@context\":\"https://schema.org\",\"@type\":\"NewsArticle\",\"headline\":\"Trump administration puts on hold $18 billion in funding for New York City infrastructure projects\",\"datePublished\":\"October 2, 2025\",\"author\":{\"@type\":\"Person\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"PressoraHub\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://www.pressorahub.com/pressorahub-icon.webp\"}},\"image\":\"https://www.pressorahub.com/images/hudson-tunnel-subway-funding.webp\",\"url\":\"https://www.pressorahub.com/us/trump-halts-nyc-transport-funding\",\"articleBody\":\"President Donald Trump ‘s administration, citing the government shutdown, said Wednesday it was putting a hold on roughly $18 billion to fund a new rail tunnel \",\"keywords\":\"us, news\"}"}],["$","link","5",{"rel":"canonical","href":"https://www.pressorahub.com/us/trump-halts-nyc-transport-funding/"}],["$","meta","6",{"property":"og:title","content":"Trump administration puts on hold $18 billion in funding for New York City infrastructure projects"}],["$","meta","7",{"property":"og:description","content":"The Trump administration paused roughly $18 billion in funding for the Hudson River rail tunnel and the Second Avenue subway extension in New York City due to the federal government shutdown, citing concerns over “unconstitutional” diversity and equity policies. Officials warn the halt threatens jobs, commuters, and major infrastructure projects."}],["$","meta","8",{"property":"og:url","content":"https://www.pressorahub.com/us/trump-halts-nyc-transport-funding/"}],["$","meta","9",{"property":"og:site_name","content":"Pressorahub"}],["$","meta","10",{"property":"og:locale","content":"en_US"}],["$","meta","11",{"property":"og:image","content":"https://www.pressorahub.com/images/hudson-tunnel-subway-funding.webp"}],["$","meta","12",{"property":"og:image:width","content":"1200"}],["$","meta","13",{"property":"og:image:height","content":"630"}],["$","meta","14",{"property":"og:image:alt","content":"Trump administration puts on hold $18 billion in funding for New York City infrastructure projects"}],["$","meta","15",{"property":"og:type","content":"article"}],["$","meta","16",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","17",{"name":"twitter:site","content":"@PressoraHub"}],["$","meta","18",{"name":"twitter:title","content":"Trump administration puts on hold $18 billion in funding for New York City infrastructure projects"}],["$","meta","19",{"name":"twitter:description","content":"The Trump administration paused roughly $18 billion in funding for the Hudson River rail tunnel and the Second Avenue subway extension in New York City due to the federal government shutdown, citing concerns over “unconstitutional” diversity and equity policies. Officials warn the halt threatens jobs, commuters, and major infrastructure projects."}],"$L21","$L22","$L23"],"error":null,"digest":"$undefined"}
