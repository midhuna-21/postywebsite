10:T40c,{"@context":"https://schema.org","@type":"NewsArticle","mainEntityOfPage":{"@type":"WebPage","@id":"https://www.pressorahub.com/us/trump-halts-nyc-transport-funding/"},"headline":"Trump administration puts on hold $18 billion in funding for New York City infrastructure projects","description":"The Trump administration paused roughly $18 billion in funding for the Hudson River rail tunnel and the Second Avenue subway extension in New York City due to the federal government shutdown, citing concerns over “unconstitutional” diversity and equity policies. Officials warn the halt threatens jobs, commuters, and major infrastructure projects.","image":"/images/hudson-tunnel-subway-funding.webp","author":{"@type":"Person","name":"David Miller","url":"https://www.pressorahub.com/our-team/"},"publisher":{"@type":"Organization","name":"PressoraHub","logo":{"@type":"ImageObject","url":"https://www.pressorahub.com/images/pressorahub-icon.webp"}},"datePublished":"2025-06-18T00:00:00.000Z","dateModified":"2025-06-18T00:00:00.000Z"}4:[["$","$Lf",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],["$","$L11",null,{"breadcrumbTitle":"Trump administration puts on hold $18 billion in funding for New York City infrastructure projects","category":"us","children":["$","div",null,{"children":[["$","section",null,{"className":"post-layout-1 padding","children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"top-content","children":[["$","div",null,{"className":"post-card single-card","children":["$","div",null,{"className":"post-content","children":[["$","$L12",null,{"title":"trump-halts-nyc-transport-funding","href":"/us","className":"card-btn bg-green","children":"us"}],["$","h1",null,{"className":"title","style":{"lineHeight":1.3},"children":"Trump administration puts on hold $18 billion in funding for New York City infrastructure projects"}],["$","ul",null,{"className":"post-list","children":[["$","li",null,{"classN