4:[["$","$Lf",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"NewsArticle\",\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://www.pressorahub.com/us/pope-leo-italy-migrants-human-trafficking/\"},\"headline\":\"Pope urges Italy to remain open to migrants during rite of passage visit to presidential palace\",\"description\":\"Pope Leo XIV thanked Italy for combating human trafficking and welcoming pilgrims, while urging continued openness and integration of migrants during a ceremonial meeting with President Sergio Mattarella at Rome’s Quirinale Palace.\",\"image\":\"/images/pope-leo-quinale-palace.webp\",\"author\":{\"@type\":\"Person\",\"name\":\"Daniel Ruiz\",\"url\":\"https://www.pressorahub.com/our-team/\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"PressoraHub\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://www.pressorahub.com/images/pressorahub-icon.webp\"}},\"datePublished\":\"2025-06-18T00:00:00.000Z\",\"dateModified\":\"2025-06-18T00:00:00.000Z\"}"}}],["$","$L10",null,{"breadcrumbTitle":"Pope urges Italy to remain open to migrants during rite of passage visit to presidential palace","category":"us","children":["$","div",null,{"children":[["$","section",null,{"className":"post-layout-1 padding","children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"top-content","children":[["$","div",null,{"className":"post-card single-card","children":["$","div",null,{"className":"post-content","children":[["$","$L11",null,{"title":"pope-leo-italy-migrants-human-trafficking","href":"/us","className":"card-btn bg-green","children":"us"}],["$","h1",null,{"className":"title","style":{"lineHeight":1.3},"children":"Pope urges Italy to remain open to migrants during rite of passage visit to presidential palace"}],["$","ul",null,{"className":"post-list","children":[["$","li",null,{"className":"author","children":["by ",["$","span",null,{"children":"Daniel Ruiz"}]]}],["$","li",null,{"className":"date","children":"October 14, 2025"}]]}],["$","p",null,{"children":"Pope Leo XIV thanked Italy for combating human trafficking and welcoming pilgrims, while urging continued openness and integration of migrants during a ceremonial meeting with President Sergio Mattarella at Rome’s Quirinale Palace."}]]}]}],["$","div",null,{"className":"post-social","children":["$","ul",null,{"className":"social-list d-flex align-items-center","children":[["$","li",null,{"children":["$","$L11",null,{"href":"/#","title":"facebook","className":"facebook","children":["$","i",null,{"className":"lab la-facebook-f"}]}]}],["$","li",null,{"children":["$","$L11",null,{"href":"/#","title":"twitter","className":"twitter","children":["$","i",null,{"className":"lab la-twitter"}]}]}],["$","li",null,{"children":["$","$L11",null,{"href":"/#","title":"linkedin","className":"linkedin","children":["$","i",null,{"className":"lab la-linkedin-in"}]}]}],["$","li",null,{"children":["$","$L11",null,{"href":"/#","title":"instagram","className":"instagram","children":["$","i",null,{"className":"lab la-instagram"}]}]}],["$","li",null,{"children":["$","$L11",null,{"href":"/#","title":"pinterest","className":"pinterest","children":["$","i",null,{"className":"lab la-pinterest-p"}]}]}]]}]}]]}],["$","div",null,{"className":"row","children":[["$","div",null,{"className":"col-lg-8","children":["$","div",null,{"className":"post-layout-content","children":[["$","div",null,{"className":"layout-thumb mb-30","children":["$","$L12",null,{"title":"Pope urges Italy to remain open to migrants during rite of passage visit to presidential palace","src":"/images/pope-leo-quinale-palace.webp","alt":"Pope urges Italy to remain open to migrants during rite of passage visit to presidential palace","width":1200,"height":800,"priority":true,"style":{"width":"100%","height":"auto"}}]}],["$","div",null,{"children":[["$","p","0",{"className":"layout-desc","style":{"marginBottom":"1rem"},"children":"Pope Leo XIV thanked Italy on Tuesday for its efforts to combat human trafficking but urged the country to remain open to welcoming and integrating migrants as he took part in a pomp-filled meeting with the Italian president.  Leo completed the rite of passage for every new pope by travelling across Rome to the Qurinale Palace for a meeting with President Sergio Mattarella.  Escorted by the presidential horse honor guard into the palace courtyard, Leo thanked Italy especially for its welcome of pilgrims during the 2025 Holy Year, which has seen millions of extra tourists pouring into the Eternal City.  Wearing his formal red cape and brocaded stole, Leo thanked Italy for its “generous assistance” to migrants and its efforts to combat human trafficking."}],"$L13","$L14","$L15"]}],"$L16","$L17"]}]}],"$L18"]}]]}]}],"$L19"]}]}]]
1a:I[9382,["206","static/chunks/5e22fd23-2e1f3144b2571522.js","894","static/chunks/894-ca74f2b972cdd536.js","687","static/chunks/687-98b0209c565be232.js","457","static/chunks/457-e5dc26d916c5cc0b.js","393","static/chunks/393-bbec8ed9f6b3db8a.js","413","static/chunks/app/%5Bcategory%5D/%5Bslug%5D/page-9c1829008c93d746.js"],"default"]
1e:I[9856,["206","static/chunks/5e22fd23-2e1f3144b2571522.js","894","static/chunks/894-ca74f2b972cdd536.js","687","static/chunks/687-98b0209c565be232.js","457","static/chunks/457-e5dc26d916c5cc0b.js","393","static/chunks/393-bbec8ed9f6b3db8a.js","413","static/chunks/app/%5Bcategory%5D/%5Bslug%5D/page-9c1829008c93d746.js"],"default"]
13:["$","p","1",{"className":"layout-desc","style":{"marginBottom":"1rem"},"children":" “I encourage you to keep alive your attitude of openness and solidarity,” he said.  “At the same time, I wish to emphasize the importance of constructive integration of newcomers into the values and traditions of Italian society, so that the mutual gift realized in this encounter of peoples may truly enrich and benefit all. ” It was a reference to Italy’s role at ground zero in Europe’s migration debate, given its proximity to North Africa — making it the preferred destination for smuggling operations setting off from Libya and Tunisia.  The right-wing government of Italian Premier Giorgia Meloni has made cracking down on illegal migration a priority, including by sending migrants back home or to detention facilities in Albania and prosecuting alleged smugglers."}]
14:["$","p","2",{"className":"layout-desc","style":{"marginBottom":"1rem"},"children":" Meloni and her hard-line minister Matteo Salvini were in the front row of the audience, held in a gilded reception room of the palace with extra-tall palace guards standing at attention.  Italy’s hard-line stance on migration has often conflicted with Pope Francis’ call for wealthier countries to welcome, defend and integrate newcomers, a position Leo repeated as recently as last week in his first main teaching document.  Tuesday’s encounter was evidence of the close ties between Italy and the Vatican, a 44-hectare (110-acre) city state in the heart of Rome.  The location itself underscored the unique and intertwined relationship: The Quirinale Palace was for centuries the summer residence of popes until 1870, when Rome was captured from the papal states and annexed into the newly unified Kingdom of Italy."}]
15:["$","p","3",{"className":"layout-desc","style":{"marginBottom":"1rem"},"children":" After decades in which popes were essentially prisoners of the Vatican, Italy and Holy See normalized relations in 1929 with the Lateran Treaty, which is still in effect."}]
