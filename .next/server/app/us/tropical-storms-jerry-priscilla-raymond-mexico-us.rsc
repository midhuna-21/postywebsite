10:T415,{"@context":"https://schema.org","@type":"NewsArticle","mainEntityOfPage":{"@type":"WebPage","@id":"https://www.pressorahub.com/us/tropical-storms-jerry-priscilla-raymond-mexico-us/"},"headline":"As Tropical Storm Jerry churns in the Atlantic, Priscilla and a nor’easter threaten US with flooding","description":"Multiple tropical storms are active near Mexico and the Atlantic, including Tropical Storms Jerry, Priscilla, and Raymond, bringing heavy rain, flooding, and high winds to the Caribbean, southwestern U.S., and Mexico’s Pacific coast. Coastal flooding is also threatening the U.S. Southeast due to King Tides and a Nor’easter.","image":"/images/tropical-storms-jerry-priscilla-raymond.webp","author":{"@type":"Person","name":"Lauren Jacobs","url":"https://www.pressorahub.com/our-team/"},"publisher":{"@type":"Organization","name":"PressoraHub","logo":{"@type":"ImageObject","url":"https://www.pressorahub.com/images/pressorahub-icon.webp"}},"datePublished":"2025-06-18T00:00:00.000Z","dateModified":"2025-06-18T00:00:00.000Z"}4:[["$","$Lf",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],["$","$L11",null,{"breadcrumbTitle":"As Tropical Storm Jerry churns in the Atlantic, Priscilla and a nor’easter threaten US with flooding","category":"us","children":["$","div",null,{"children":[["$","section",null,{"className":"post-layout-1 padding","children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"top-content","children":[["$","div",null,{"className":"post-card single-card","children":["$","div",null,{"className":"post-content","children":[["$","$L12",null,{"title":"tropical-storms-jerry-priscilla-raymond-mexico-us","href":"/us","className":"card-btn bg-green","children":"us"}],["$","h1",null,{"className":"title","style":{"lineHeight":1.3},"children":"As Tropical Storm Jerry churns in the Atlantic, Priscilla and a nor’easter threaten US with flooding"}],["$","ul",null,{"className":"post-list","childre