8:{"metadata":[["$","title","0",{"children":"As Tropical Storm Jerry churns in the Atlantic, Priscilla and a nor’easter threaten US with flooding"}],["$","meta","1",{"name":"description","content":"Multiple tropical storms are active near Mexico and the Atlantic, including Tropical Storms Jerry, Priscilla, and Raymond, bringing heavy rain, flooding, and high winds to the Caribbean, southwestern U.S., and Mexico’s Pacific coast. Coastal flooding is also threatening the U.S. Southeast due to King Tides and a Nor’easter."}],["$","meta","2",{"name":"author","content":"Lauren Jacobs"}],["$","meta","3",{"name":"keywords","content":"us, news, As Tropical Storm Jerry churns in the Atlantic, Priscilla and a nor’easter threaten US with flooding"}],["$","meta","4",{"name":"script:ld+json","content":"{\"@context\":\"https://schema.org\",\"@type\":\"NewsArticle\",\"headline\":\"As Tropical Storm Jerry churns in the Atlantic, Priscilla and a nor’easter threaten US with flooding\",\"datePublished\":\"October 10, 2025\",\"author\":{\"@type\":\"Person\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"PressoraHub\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://www.pressorahub.com/pressorahub-icon.webp\"}},\"image\":\"https://www.pressorahub.com/images/tropical-storms-jerry-priscilla-raymond.webp\",\"url\":\"https://www.pressorahub.com/us/tropical-storms-jerry-priscilla-raymond-mexico-us\",\"articleBody\":\"Tropical Storm Jerry churned Thursday in the Atlantic on its approach to the Leeward Islands as Tropical Storm Priscilla and Tropical Storm Raymond moved along \",\"keywords\":\"us, news\"}"}],["$","link","5",{"rel":"canonical","href":"https://www.pressorahub.com/us/tropical-storms-jerry-priscilla-raymond-mexico-us"}],["$","meta","6",{"property":"og:title","content":"As Tropical Storm Jerry churns in the Atlantic, Priscilla and a nor’easter threaten US with flooding"}],["$","meta","7",{"property":"og:description","content":"Multiple tropical storms are active near Mex