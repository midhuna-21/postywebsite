8:{"metadata":[["$","title","0",{"children":"Dallas ICE facility shooter feared radiation exposure and practiced shooting, records show"}],["$","meta","1",{"name":"description","content":"Newly released records reveal that Joshua Jahn, the 29-year-old who killed two detainees in a September Dallas ICE shooting, was a reclusive young man obsessed with AI and video games, who believed he suffered from radiation sickness after a stint in Washington state. Authorities found no clear motive beyond his anti-ICE sentiments and online activity."}],["$","meta","2",{"name":"author","content":"Lauren Jacobs"}],["$","meta","3",{"name":"keywords","content":"us, news, Dallas ICE facility shooter feared radiation exposure and practiced shooting, records show"}],["$","meta","4",{"name":"script:ld+json","content":"{\"@context\":\"https://schema.org\",\"@type\":\"NewsArticle\",\"headline\":\"Dallas ICE facility shooter feared radiation exposure and practiced shooting, records show\",\"datePublished\":\"October 14, 2025\",\"author\":{\"@type\":\"Person\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"PressoraHub\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://www.pressorahub.com/pressorahub-icon.webp\"}},\"image\":\"https://www.pressorahub.com/images/joshua-jahn-dallas-ice.webp\",\"url\":\"https://www.pressorahub.com/us/dallas-ice-shooting-joshua-jahn-profile\",\"articleBody\":\"The parents of the 29-year-old gunman who opened fire on a Dallas immigration facility in September told police their son was “completely normal” before he move\",\"keywords\":\"us, news\"}"}],["$","link","5",{"rel":"canonical","href":"https://www.pressorahub.com/us/dallas-ice-shooting-joshua-jahn-profile"}],["$","meta","6",{"property":"og:title","content":"Dallas ICE facility shooter feared radiation exposure and practiced shooting, records show"}],["$","meta","7",{"property":"og:description","content":"Newly released records reveal that Joshua Jahn, the 29-year-old who killed two detainees in 