10:T407,{"@context":"https://schema.org","@type":"NewsArticle","mainEntityOfPage":{"@type":"WebPage","@id":"https://www.pressorahub.com/us/dallas-ice-shooting-joshua-jahn-profile/"},"headline":"Dallas ICE facility shooter feared radiation exposure and practiced shooting, records show","description":"Newly released records reveal that Joshua Jahn, the 29-year-old who killed two detainees in a September Dallas ICE shooting, was a reclusive young man obsessed with AI and video games, who believed he suffered from radiation sickness after a stint in Washington state. Authorities found no clear motive beyond his anti-ICE sentiments and online activity.","image":"/images/joshua-jahn-dallas-ice.webp","author":{"@type":"Person","name":"Lauren Jacobs","url":"https://www.pressorahub.com/our-team/"},"publisher":{"@type":"Organization","name":"PressoraHub","logo":{"@type":"ImageObject","url":"https://www.pressorahub.com/images/pressorahub-icon.webp"}},"datePublished":"2025-06-18T00:00:00.000Z","dateModified":"2025-06-18T00:00:00.000Z"}4:[["$","$Lf",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],["$","$L11",null,{"breadcrumbTitle":"Dallas ICE facility shooter feared radiation exposure and practiced shooting, records show","category":"us","children":["$","div",null,{"children":[["$","section",null,{"className":"post-layout-1 padding","children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"top-content","children":[["$","div",null,{"className":"post-card single-card","children":["$","div",null,{"className":"post-content","children":[["$","$L12",null,{"title":"dallas-ice-shooting-joshua-jahn-profile","href":"/us","className":"card-btn bg-green","children":"us"}],["$","h1",null,{"className":"title","style":{"lineHeight":1.3},"children":"Dallas ICE facility shooter feared radiation exposure and practiced shooting, records show"}],["$","ul",null,{"className":"post-list","children":[["$","li",null,{"className":"autho