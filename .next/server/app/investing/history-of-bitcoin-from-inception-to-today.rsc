"div",null,{"className":"row","children":[["$","div",null,{"className":"col-lg-8","children":["$","div",null,{"className":"post-layout-content","children":[["$","div",null,{"className":"layout-thumb mb-30","children":["$","$L12",null,{"title":"The History of Bitcoin: From Inception to Today","src":"/images/history-of-bitcoin-2025.webp","alt":"The History of Bitcoin: From Inception to Today","width":1200,"height":800,"priority":true,"style":{"width":"100%","height":"auto"}}]}],["$","div",null,{"children":[["$","p","0",{"className":"layout-desc","style":{"marginBottom":"1rem"},"children":"$13"}],"$L14","$L15","$L16"]}],"$L17","$L18"]}]}],"$L19"]}]]}]}],"$L1a"]}]}]]
