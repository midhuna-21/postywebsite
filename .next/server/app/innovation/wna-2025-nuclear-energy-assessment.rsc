"className":"layout-thumb mb-30","children":["$","$L12",null,{"title":"2025 Performance Report by WNA: Evaluating the nuclear energy sector","src":"/images/wna-2025-performance-report.webp","alt":"2025 Performance Report by WNA: Evaluating the nuclear energy sector","width":1200,"height":800,"priority":true,"style":{"width":"100%","height":"auto"}}]}],["$","div",null,{"children":[["$","p","0",{"className":"layout-desc","style":{"marginBottom":"1rem"},"children":"$13"}],"$L14","$L15","$L16"]}],"$L17","$L18"]}]}],"$L19"]}]]}]}],"$L1a"]}]}]]
