dications of an atmosphere on TRAPPIST-1e, which is considered a potentially habitable exoplanet. "}]]}]}],["$","div",null,{"className":"post-social","children":["$","ul",null,{"className":"social-list d-flex align-items-center","children":[["$","li",null,{}],["$","li",null,{"children":["$","$L11",null,{"href":"https://www.instagram.com/daniel_ruiz41/","className":"instagram","title":"instagram","children":["$","i",null,{"className":"lab la-instagram"}]}]}],["$","li",null,{"children":["$","$L11",null,{"href":"https://medium.com/@daniel_ruiz","className":"","style":{"border":""},"children":["$","i",null,{"className":"lab la-medium"}]}]}],["$","li",null,{"children":["$","$L11",null,{"href":"https://substack.com/@daniel212537","className":"pinterest","children":["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":"20","height":"15","viewBox":"0 0 256 256","children":["$","g",null,{"transform":"scale(5.12,5.12)","children":[["$","path",null,{"d":"M43,11h-35v-6h35z"}],["$","path",null,{"d":"M43,19h-35v-6h35z"}],["$","path",null,{"d":"M43,44.805l-17.016,-10.636l-17.984,10.579v-23.748h35z"}]]}]}]}]}]]}]}]]}],["$","div",null,{"className":"row","children":[["$","div",null,{"className":"col-lg-8","children":["$","div",null,{"className":"post-layout-content","children":[["$","div",null,{"className":"layout-thumb mb-30","children":["$","$L12",null,{"title":"Webb Telescope Identifies Atmosphere on Possibly Habitable Exoplanet TRAPPIST-1e","src":"/images/trappist-1e-atmosphere.webp","alt":"Webb Telescope Identifies Atmosphere on Possibly Habitable Exoplanet TRAPPIST-1e","width":1200,"height":800,"priority":true,"style":{"width":"100%","height":"auto"}}]}],["$","div",null,{"children":[["$","p","0",{"className":"layout-desc","style":{"marginBottom":"1rem"},"children":"$13"}],"$L14","$L15","$L16"]}],"$L17","$L18"]}]}],"$L19"]}]]}]}],"$L1a"]}]}]]
