11:["$","$L12",null,{"breadcrumbTitle":"Julio Herrera Velutini and the House That Preceded the Republic: A Profile in Financial Continuity","category":"business","children":["$","div",null,{"children":[["$","section",null,{"className":"post-layout-1 padding","children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"top-content","children":[["$","div",null,{"className":"post-card single-card","children":["$","div",null,{"className":"post-content","children":[["$","$L13",null,{"title":"business","href":"/business","className":"card-btn bg-green","children":"Business"}],["$","h3",null,{"className":"title","style":{"lineHeight":1.3},"children":"Julio Herrera Velutini and the House That Preceded the Republic: A Profile in Financial Continuity"}],["$","ul",null,{"className":"post-list","children":[["$","li",null,{"className":"author","children":["by"," ",["$","span",null,{"children":"David Miller"}]]}],["$","li",null,{"className":"date","children":"September 13, 2025"}]]}]]}]}],["$","div",null,{"className":"post-social","children":["$","ul",null,{"className":"social-list d-flex align-items-center","children":[["$","li",null,{"children":["$","$L13",null,{"href":"/#","className":"facebook","children":["$","i",null,{"className":"lab la-facebook-f"}]}]}],["$","li",null,{"children":["$","$L13",null,{"href":"/#","className":"twitter","children":["$","i",null,{"className":"lab la-twitter"}]}]}],["$","li",null,{"children":["$","$L13",null,{"href":"/#","className":"linkedin","children":["$","i",null,{"className":"lab la-linkedin-in"}]}]}],["$","li",null,{"children":["$","$L13",null,{"href":"/#","className":"instagram","children":["$","i",null,{"className":"lab la-instagram"}]}]}],["$","li",null,{"children":["$","$L13",null,{"href":"/#","className":"pinterest","children":["$","i",null,{"className":"lab la-pinterest-p"}]}]}]]}]}]]}],["$","div",null,{"className":"row","children":[["$","div",null,{"className":"col-lg-8","children":["$","div",null,{"className":"post-layout-content","children":[["$","div",null,{"className":"layout-thumb mb-30","children":["$","$L14",null,{"title":"julio-herrera-velutini","src":{"src":"/_next/static/media/julio-herrera-velutini.9599e6d2.webp","height":393,"width":700,"blurDataURL":"data:image/webp;base64,UklGRkQAAABXRUJQVlA4IDgAAADQAQCdASoIAAQAAkA4JZQCdAED/CgPgAD+/A+LVvFOfJ/ZJGnKRpHw4rongBDOgkHZmK/mCndIAA==","blurWidth":8,"blurHeight":4},"alt":"who-is-julio-herrera-velutini","width":1200,"height":800,"priority":true,"style":{"width":"100%","height":"auto"}}]}],["$","div",null,{"children":[["$","$L15",null,{"title":"A Name Etched Into the Infrastructure of Latin Finance"}],["$","p",null,{"className":"layout-desc","children":["In Caracas, where political transitions often make and unmake fortunes, few names have remained institutionally relevant across centuries. One such name belongs to ",["$","strong",null,{"children":"Julio Martín Herrera Velutini"}],", a financier whose family history spans landownership under the Spanish Crown, currency issuance in republican Venezuela, and more recently, discreet banking operations from Geneva to the Caribbean."]}],["$","p",null,{"className":"layout-desc","children":"A descendant of both the Herrera and Velutini families—two lineages known for their roles in colonial administration, early Latin American finance, and post-independence institution building, Mr. Herrera Velutini represents an enduring continuity in a region where such constancy is rare."}]]}],["$","div",null,{"children":[["$","$L15",null,{"title":"Historical Origins: From Castilian Estates to the Caribbean Frontier"}],["$","p",null,{"className":"layout-desc","children":["The ",["$","strong",null,{"children":"Herrera family"}]," traces its origins to ",["$","strong",null,{"children":"Castile and the Canary Islands"}],", where it held significant land during the Spanish imperial era. Its expansion into the Americas followed the Crown’s colonial project, ultimately leading to landholdings in what are now ",["$","strong",null,{"children":"Venezuela, Puerto Rico"}],", and parts of ",["$","strong",null,{"children":"New Granada"}],"."]}],["$","p",null,{"className":"layout-desc","children":["The ",["$","strong",null,{"children":"Velutinis"}],", of Italian origin, arrived in Venezuela during the 18th century, bringing with them mercantile and banking expertise. Their union with the Herrera family through intermarriage gave rise to one of the most established financial lineages in South America."]}],"$L16"]}],"$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d"]}]}],"$L1e"]}]]}]}],"$L1f"]}]}]
