016,-10.636l-17.984,10.579v-23.748h35z"}]]}]}]}]}]]}]}]]}],["$","div",null,{"className":"row","children":[["$","div",null,{"className":"col-lg-8","children":["$","div",null,{"className":"post-layout-content","children":[["$","div",null,{"className":"layout-thumb mb-30","children":["$","$L14",null,{"title":"julio-herrera-velutini","src":{"src":"/_next/static/media/julio-herrera-velutini.385b7b50.webp","height":393,"width":700,"blurDataURL":"data:image/webp;base64,UklGRkQAAABXRUJQVlA4IDgAAADQAQCdASoIAAQAAkA4JZQCdAED/CgPgAD+/A+LVvFOfJ/ZJGnKRpHw4rongBDOgkHZmK/mCndIAA==","blurWidth":8,"blurHeight":4},"alt":"who-is-julio-herrera-velutini","width":1200,"height":800,"priority":true,"style":{"width":"100%","height":"auto"}}]}],["$","div",null,{"children":[["$","$L15",null,{"title":"A Name Etched Into the Infrastructure of Latin Finance"}],["$","p",null,{"className":"layout-desc","children":["In Caracas, where political transitions often make and unmake fortunes, few names have remained institutionally relevant across centuries. One such name belongs to ",["$","strong",null,{"children":"Julio Martín Herrera Velutini"}],", a financier whose family history spans landownership under the Spanish Crown, currency issuance in republican Venezuela, and more recently, discreet banking operations from Geneva to the Caribbean."]}],["$","p",null,{"className":"layout-desc","children":"A descendant of both the Herrera and Velutini families—two lineages known for their roles in colonial administration, early Latin American finance, and post-independence institution building, Mr. Herrera Velutini represents an enduring continuity in a region where such constancy is rare."}]]}],["$","div",null,{"children":[["$","$L15",null,{"title":"Historical Origins: From Castilian Estates to the Caribbean Frontier"}],["$","p",null,{"className":"layout-desc","children":["The ",["$","strong",null,{"children":"Herrera family"}]," traces its origins to ",["$","strong",null,{"children":"Castile and the Canary Islands"}],", where it held significant land during the Spanish imperial era. Its expansion into the Americas followed the Crown’s colonial project, ultimately leading to landholdings in what are now ",["$","strong",null,{"children":"Venezuela, Puerto Rico"}],", and parts of ","$L16","."]}],"$L17","$L18"]}],"$L19","$L1a","$L1b","$L1c","$L1d","$L1e"]}]}],"$L1f"]}]]}]}],"$L20"]}]}]
21:I[9382,["206","static/chunks/5e22fd23-2e1f3144b2571522.js","894","static/chunks/894-ca74f2b972cdd536.js","687","static/chunks/687-98b0209c565be232.js","457","static/chunks/457-f6ee94d31b38d181.js","393","static/chunks/393-bbec8ed9f6b3db8a.js","413","static/chunks/app/%5Bcategory%5D/%5Bslug%5D/page-9c1829008c93d746.js"],"default"]
