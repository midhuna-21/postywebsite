8:{"metadata":[["$","title","0",{"children":"Julio Herrera Velutini and the House That Preceded the Republic: A Profile in Financial Continuity"}],["$","meta","1",{"name":"description","content":"In Caracas, where political transitions often make and unmake fortunes, few names have remained institutionally relevant across centuries. One such name belongs to Julio Martín Herrera Velutini, a financier whose family history spans landownership under the Spanish Crown, currency issuance in republican Venezuela, and more recently, discreet banking operations from Geneva to the Caribbean."}],["$","meta","2",{"name":"author","content":"Staff Writer"}],["$","meta","3",{"name":"keywords","content":"Julio Herrera Velutini, news, Julio Herrera Velutini and the House That Preceded the Republic: A Profile in Financial Continuity"}],["$","link","4",{"rel":"canonical","href":"https://www.pressorahub.com"}],["$","link","5",{"rel":"alternate","hrefLang":"en","href":"https://www.pressorahub.com"}],["$","link","6",{"rel":"alternate","hrefLang":"x-default","href":"https://www.pressorahub.com"}],["$","meta","7",{"property":"og:title","content":"Julio Herrera Velutini and the House That Preceded the Republic: A Profile in Financial Continuity"}],["$","meta","8",{"property":"og:description","content":"In Caracas, where political transitions often make and unmake fortunes, few names have remained institutionally relevant across centuries. One such name belongs to Julio Martín Herrera Velutini, a financier whose family history spans landownership under the Spanish Crown, currency issuance in republican Venezuela, and more recently, discreet banking operations from Geneva to the Caribbean."}],["$","meta","9",{"property":"og:url","content":"https://www.pressorahub.com//business/julio-herrera-velutini-house-preceded-republic-financial-continuity"}],["$","meta","10",{"property":"og:site_name","content":"pressorahub"}],["$","meta","11",{"property":"og:locale","content":"en_US"}],["$","meta","12",