4:[["$","$Lf",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"NewsArticle\",\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://www.pressorahub.com/business/great-lock-in-tiktok-financial-goals/\"},\"headline\":\"How ‘The Great Lock In’ can help achieve your financial and wellness goals\",\"description\":\"“The Great Lock In” TikTok trend encourages participants to focus intensely on life and financial goals from September through year-end, helping build habits, savings, and accountability.\",\"image\":\"/images/great-lock-in-finance.webp\",\"author\":{\"@type\":\"Person\",\"name\":\"Lauren Jacobs\",\"url\":\"https://www.pressorahub.com/our-team/\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"PressoraHub\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://www.pressorahub.com/images/pressorahub-icon.webp\"}},\"datePublished\":\"2025-06-18T00:00:00.000Z\",\"dateModified\":\"2025-06-18T00:00:00.000Z\"}"}}],["$","$L10",null,{"breadcrumbTitle":"How ‘The Great Lock In’ can help achieve your financial and wellness goals","category":"business","children":["$","div",null,{"children":[["$","section",null,{"className":"post-layout-1 padding","children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"top-content","children":[["$","div",null,{"className":"post-card single-card","children":["$","div",null,{"className":"post-content","children":[["$","$L11",null,{"title":"great-lock-in-tiktok-financial-goals","href":"/business","className":"card-btn bg-green","children":"business"}],["$","h1",null,{"className":"title","style":{"lineHeight":1.3},"children":"How ‘The Great Lock In’ can help achieve your financial and wellness goals"}],["$","ul",null,{"className":"post-list","children":[["$","li",null,{"className":"author","children":["by ",["$","span",null,{"children":"Lauren Jacobs"}]]}],["$","li",null,{"className":"date","children":"October 8, 2025"}]]}],["$","p",null,{"children":"“The Great Lock In” TikTok trend encourages participants to focus intensely on life and financial goals from September through year-end, helping build habits, savings, and accountability."}]]}]}],["$","div",null,{"className":"post-social","children":["$","ul",null,{"className":"social-list d-flex align-items-center","children":[["$","li",null,{}],["$","li",null,{"children":["$","$L11",null,{"href":"https://www.instagram.com/laur.enjacobs001/","className":"instagram","children":["$","i",null,{"className":"lab la-instagram"}]}]}],["$","li",null,{"children":["$","$L11",null,{"href":"https://medium.com/@lauren_jacobs","className":"","style":{"border":""},"children":["$","i",null,{"className":"lab la-medium"}]}]}],["$","li",null,{"children":["$","$L11",null,{"href":"https://substack.com/@laurenjacobs672308","className":"pinterest","children":["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":"20","height":"15","viewBox":"0 0 256 256","children":["$","g",null,{"transform":"scale(5.12,5.12)","children":[["$","path",null,{"d":"M43,11h-35v-6h35z"}],["$","path",null,{"d":"M43,19h-35v-6h35z"}],["$","path",null,{"d":"M43,44.805l-17.016,-10.636l-17.984,10.579v-23.748h35z"}]]}]}]}]}]]}]}]]}],["$","div",null,{"className":"row","children":[["$","div",null,{"className":"col-lg-8","children":["$","div",null,{"className":"post-layout-content","children":[["$","div",null,{"className":"layout-thumb mb-30","children":["$","$L12",null,{"title":"How ‘The Great Lock In’ can help achieve your financial and wellness goals","src":"/images/great-lock-in-finance.webp","alt":"How ‘The Great Lock In’ can help achieve your financial and wellness goals","width":1200,"height":800,"priority":true,"style":{"width":"100%","height":"auto"}}]}],["$","div",null,{"children":[["$","p","0",{"className":"layout-desc","style":{"marginBottom":"1rem"},"children":"As the end of 2025 approaches, a viral TikTok trend is helping people achieve their wellness goals: “The Great Lock In” encourages participants to finish the year strong by fully focusing on their life goals from Sept.  1 through Dec.  31.  Many people focus on exercise or eating healthier.  But the trend can also help you achieve your financial goals.  There are no set rules for “The Great Lock In. ” The phrase “lock in” is popular on social media and it means to focus intensely on a task.  “Something I like about this particular trend is that it’s like New Year’s resolutions’ little sister,” said Lindsay Bryan-Podvin, financial therapist and founder of Mind Money Balance, a financial wellness podcast and blog.  For Julissa Mercedes, 28, one of her lock in goals is to build an $2,500 emergency savings fund.  “Having some liquid cash will make me feel a little bit safer,” said Mercedes, a San Diego resident who works in finance."}],"$L13","$L14","$L15"]}],"$L16","$L17"]}]}],"$L18"]}]]}]}],"$L19"]}]}]]
1d:I[9382,["206","static/chunks/5e22fd23-2e1f3144b2571522.js","894","static/chunks/894-ca74f2b972cdd536.js","687","static/chunks/687-98b0209c565be232.js","457","static/chunks/457-f6ee94d31b38d181.js","393","static/chunks/393-bbec8ed9f6b3db8a.js","413","static/chunks/app/%5Bcategory%5D/%5Bslug%5D/page-9c1829008c93d746.js"],"default"]
