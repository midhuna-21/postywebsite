4:[["$","$Lf",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"NewsArticle\",\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://www.pressorahub.com/business/gen-z-credit-scores-drop-2025/\"},\"headline\":\"Gen Z’s credit scores are dropping. Here’s what to do if yours is too\",\"description\":\"Gen Z credit scores have dropped the most in recent years, driven largely by student loan debt, highlighting the importance of on-time payments, low credit utilization, and financial planning.\",\"image\":\"/images/gen-z-credit-scores.webp\",\"author\":{\"@type\":\"Person\",\"name\":\"David Miller\",\"url\":\"https://www.pressorahub.com/our-team/\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"PressoraHub\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://www.pressorahub.com/images/pressorahub-icon.webp\"}},\"datePublished\":\"2025-06-18T00:00:00.000Z\",\"dateModified\":\"2025-06-18T00:00:00.000Z\"}"}}],["$","$L10",null,{"breadcrumbTitle":"Gen Z’s credit scores are dropping. Here’s what to do if yours is too","category":"business","children":["$","div",null,{"children":[["$","section",null,{"className":"post-layout-1 padding","children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"top-content","children":[["$","div",null,{"className":"post-card single-card","children":["$","div",null,{"className":"post-content","children":[["$","$L11",null,{"title":"gen-z-credit-scores-drop-2025","href":"/business","className":"card-btn bg-green","children":"business"}],["$","h1",null,{"className":"title","style":{"lineHeight":1.3},"children":"Gen Z’s credit scores are dropping. Here’s what to do if yours is too"}],["$","ul",null,{"className":"post-list","children":[["$","li",null,{"className":"author","children":["by ",["$","span",null,{"children":"David Miller"}]]}],["$","li",null,{"className":"date","children":"September 19, 2025"}]]}],["$","p",null,{"children":"Gen Z credit scores have dropped the most in recent years, driven largely by student loan debt, highlighting the importance of on-time payments, low credit utilization, and financial planning."}]]}]}],["$","div",null,{"className":"post-social","children":["$","ul",null,{"className":"social-list d-flex align-items-center","children":[["$","li",null,{}],["$","li",null,{"children":["$","$L11",null,{"href":"https://www.instagram.com/millerdavid4569/","className":"instagram","children":["$","i",null,{"className":"lab la-instagram"}]}]}],["$","li",null,{"children":["$","$L11",null,{"href":"https://medium.com/@david_miller_48409","className":"","style":{"border":""},"children":["$","i",null,{"className":"lab la-medium"}]}]}],["$","li",null,{"children":["$","$L11",null,{"href":"https://substack.com/@davidmiller170279","className":"pinterest","children":["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":"20","height":"15","viewBox":"0 0 256 256","children":["$","g",null,{"transform":"scale(5.12,5.12)","children":[["$","path",null,{"d":"M43,11h-35v-6h35z"}],["$","path",null,{"d":"M43,19h-35v-6h35z"}],["$","path",null,{"d":"M43,44.805l-17.016,-10.636l-17.984,10.579v-23.748h35z"}]]}]}]}]}]]}]}]]}],["$","div",null,{"className":"row","children":[["$","div",null,{"className":"col-lg-8","children":["$","div",null,{"className":"post-layout-content","children":[["$","div",null,{"className":"layout-thumb mb-30","children":["$","$L12",null,{"title":"Gen Z’s credit scores are dropping. Here’s what to do if yours is too","src":"/images/gen-z-credit-scores.webp","alt":"Gen Z’s credit scores are dropping. Here’s what to do if yours is too","width":1200,"height":800,"priority":true,"style":{"width":"100%","height":"auto"}}]}],["$","div",null,{"children":[["$","p","0",{"className":"layout-desc","style":{"marginBottom":"1rem"},"children":"Gen Z has seen its credit scores drop more than any other generation over the past year, largely because of student loan debt, according to a new report out this week.  The total national average credit score dropped two points this year to 715, according to the report from credit scoring company FICO.  But Gen Z’s average score dropped three points to 676, the largest year-over-year decrease among any age group since 2020.  A credit score is a mathematical formula that helps lenders determine how likely you are to pay back a loan.  Credit scores are based on your credit history and range from 300 to 850.  The report found that 34% of Gen Z consumers have open student loans, compared to 17% of the total population, and the decline in credit scores is primarily due to the resumption of student loan delinquency reporting.  The U. S.  Department of Education paused federal student loan payments in March 2020, offering borrowers relief during the economic chaos of the coronavirus pandemic."}],"$L13","$L14","$L15"]}],"$L16","$L17"]}]}],"$L18"]}]]}]}],"$L19"]}]}]]
