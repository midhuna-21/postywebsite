4:[["$","$Lf",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"NewsArticle\",\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://www.pressorahub.com/business/roundhill-meme-etf-launch/\"},\"headline\":\"Meme stock resurgence prompts return of central meme investment fund\",\"description\":\"Roundhill Investments is relaunching a meme stock ETF under the ticker “MEME,” allowing investors to gain exposure to volatile, internet-driven stocks like GameStop, Opendoor, and Plug Power. The fund aims to capture short-term trends fueled by social media and online forums.\",\"image\":\"/images/meme-stock-etf.webp\",\"author\":{\"@type\":\"Person\",\"name\":\"David Miller\",\"url\":\"https://www.pressorahub.com/our-team/\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"PressoraHub\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://www.pressorahub.com/images/pressorahub-icon.webp\"}},\"datePublished\":\"2025-06-18T00:00:00.000Z\",\"dateModified\":\"2025-06-18T00:00:00.000Z\"}"}}],["$","$L10",null,{"breadcrumbTitle":"Meme stock resurgence prompts return of central meme investment fund","category":"business","children":["$","div",null,{"children":[["$","section",null,{"className":"post-layout-1 padding","children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"top-content","children":[["$","div",null,{"className":"post-card single-card","children":["$","div",null,{"className":"post-content","children":[["$","$L11",null,{"title":"roundhill-meme-etf-launch","href":"/business","className":"card-btn bg-green","children":"business"}],["$","h1",null,{"className":"title","style":{"lineHeight":1.3},"children":"Meme stock resurgence prompts return of central meme investment fund"}],["$","ul",null,{"className":"post-list","children":[["$","li",null,{"className":"author","children":["by ",["$","span",null,{"children":"David Miller"}]]}],["$","li",null,{"className":"date","children":"October 9, 2025"}]]}],["$","p",null,{"children":"Roundhill Investments is relaunching a meme stock ETF under the ticker “MEME,” allowing investors to gain exposure to volatile, internet-driven stocks like GameStop, Opendoor, and Plug Power. The fund aims to capture short-term trends fueled by social media and online forums."}]]}]}],["$","div",null,{"className":"post-social","children":["$","ul",null,{"className":"social-list d-flex align-items-center","children":[["$","li",null,{}],["$","li",null,{"children":["$","$L11",null,{"href":"https://www.instagram.com/millerdavid4569/","className":"instagram","title":"instagram","children":["$","i",null,{"className":"lab la-instagram"}]}]}],["$","li",null,{"children":["$","$L11",null,{"href":"https://medium.com/@david_miller_48409","className":"","style":{"border":""},"children":["$","i",null,{"className":"lab la-medium"}]}]}],["$","li",null,{"children":["$","$L11",null,{"href":"https://substack.com/@davidmiller170279","className":"pinterest","children":["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":"20","height":"15","viewBox":"0 0 256 256","children":["$","g",null,{"transform":"scale(5.12,5.12)","children":[["$","path",null,{"d":"M43,11h-35v-6h35z"}],["$","path",null,{"d":"M43,19h-35v-6h35z"}],["$","path",null,{"d":"M43,44.805l-17.016,-10.636l-17.984,10.579v-23.748h35z"}]]}]}]}]}]]}]}]]}],["$","div",null,{"className":"row","children":[["$","div",null,{"className":"col-lg-8","children":["$","div",null,{"className":"post-layout-content","children":[["$","div",null,{"className":"layout-thumb mb-30","children":["$","$L12",null,{"title":"Meme stock resurgence prompts return of central meme investment fund","src":"/images/meme-stock-etf.webp","alt":"Meme stock resurgence prompts return of central meme investment fund","width":1200,"height":800,"priority":true,"style":{"width":"100%","height":"auto"}}]}],["$","div",null,{"children":[["$","p","0",{"className":"layout-desc","style":{"marginBottom":"1rem"},"children":"A resurgence of meme stock interest has prompted the return of a one-stop fund for the volatile and quirky investments.  Roundhill Investments is launching a meme ETF, which is an exchange-traded fund consisting solely of meme stocks.  Several of those stocks have ridden a wave of meme investment sentiment this year.  The move comes two years after the provider of ETFs closed the fund because of slumping interest.  The new fund trades under the “MEME” symbol.  Investors have been sporadically turning to meme stocks throughout 2025 in an effort to find bargains amid a very pricey stock market."}],"$L13","$L14","$L15"]}],"$L16","$L17"]}]}],"$L18"]}]]}]}],"$L19"]}]}]]
1a:I[9382,["206","static/chunks/5e22fd23-2e1f3144b2571522.js","894","static/chunks/894-e002e1fad4e8fb0b.js","687","static/chunks/687-98b0209c565be232.js","457","static/chunks/457-46e1a49bd71efb62.js","393","static/chunks/393-bbec8ed9f6b3db8a.js","413","static/chunks/app/%5Bcategory%5D/%5Bslug%5D/page-9c1829008c93d746.js"],"default"]
