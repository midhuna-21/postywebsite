8:{"metadata":[["$","title","0",{"children":"Canada’s last hockey stick factory survives in face of tariff threats and globalization"}],["$","meta","1",{"name":"description","content":"Roustan Hockey, Canada’s last major wooden hockey stick manufacturer, faces challenges from U.S. tariffs and shifting global production. The artisanal factory continues producing traditional sticks amid declining demand, preserving both Canadian craftsmanship and a national sports legacy."}],["$","meta","2",{"name":"author","content":"David Miller"}],["$","meta","3",{"name":"keywords","content":"business, news, Canada’s last hockey stick factory survives in face of tariff threats and globalization"}],["$","meta","4",{"name":"script:ld+json","content":"{\"@context\":\"https://schema.org\",\"@type\":\"NewsArticle\",\"headline\":\"Canada’s last hockey stick factory survives in face of tariff threats and globalization\",\"datePublished\":\"October 6, 2025\",\"author\":{\"@type\":\"Person\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"PressoraHub\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://www.pressorahub.com/pressorahub-icon.webp\"}},\"image\":\"https://www.pressorahub.com/images/roustan-hockey-factory.webp\",\"url\":\"https://www.pressorahub.com/business/roustan-hockey-canada-tariffs\",\"articleBody\":\"Wearing protective gloves and earplugs, a worker feeds lengths of wood into a machine that makes an earsplitting whine as it automatically cuts a groove into th\",\"keywords\":\"business, news\"}"}],["$","link","5",{"rel":"canonical","href":"https://www.pressorahub.com/business/roustan-hockey-canada-tariffs/"}],["$","meta","6",{"property":"og:title","content":"Canada’s last hockey stick factory survives in face of tariff threats and globalization"}],["$","meta","7",{"property":"og:description","content":"Roustan Hockey, Canada’s last major wooden hockey stick manufacturer, faces challenges from U.S. tariffs and shifting global production. The artisanal factory continu