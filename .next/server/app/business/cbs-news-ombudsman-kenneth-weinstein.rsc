4:[["$","$Lf",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"NewsArticle\",\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://www.pressorahub.com/business/cbs-news-ombudsman-kenneth-weinstein/\"},\"headline\":\"CBS News Appoints Ombudsman With Expanded Role and Unique Background\",\"description\":\"CBS News names Kenneth Weinstein as its new ombudsman, with duties and a background that differ from traditional journalism definitions of the role..\",\"image\":\"/images/cbs-news-ombudsman.webp\",\"author\":{\"@type\":\"Person\",\"name\":\"Lauren Jacobs\",\"url\":\"https://www.pressorahub.com/our-team/\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"PressoraHub\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://www.pressorahub.com/images/pressorahub-icon.webp\"}},\"datePublished\":\"2025-06-18T00:00:00.000Z\",\"dateModified\":\"2025-06-18T00:00:00.000Z\"}"}}],["$","$L10",null,{"breadcrumbTitle":"CBS News Appoints Ombudsman With Expanded Role and Unique Background","category":"business","children":["$","div",null,{"children":[["$","section",null,{"className":"post-layout-1 padding","children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"top-content","children":[["$","div",null,{"className":"post-card single-card","children":["$","div",null,{"className":"post-content","children":[["$","$L11",null,{"title":"cbs-news-ombudsman-kenneth-weinstein","href":"/business","className":"card-btn bg-green","children":"business"}],["$","h1",null,{"className":"title","style":{"lineHeight":1.3},"children":"CBS News Appoints Ombudsman With Expanded Role and Unique Background"}],["$","ul",null,{"className":"post-list","children":[["$","li",null,{"className":"author","children":["by ",["$","span",null,{"children":"Lauren Jacobs"}]]}],["$","li",null,{"className":"date","children":"9th September 2025"}]]}],["$","p",null,{"children":"CBS News names Kenneth Weinstein as its new ombudsman, with duties and a background that differ from traditional journalism definitions of the role.."}]]}]}],["$","div",null,{"className":"post-social","children":["$","ul",null,{"className":"social-list d-flex align-items-center","children":[["$","li",null,{"children":["$","$L11",null,{"href":"/#","title":"facebook","className":"facebook","children":["$","i",null,{"className":"lab la-facebook-f"}]}]}],["$","li",null,{"children":["$","$L11",null,{"href":"/#","title":"twitter","className":"twitter","children":["$","i",null,{"className":"lab la-twitter"}]}]}],["$","li",null,{"children":["$","$L11",null,{"href":"/#","title":"linkedin","className":"linkedin","children":["$","i",null,{"className":"lab la-linkedin-in"}]}]}],["$","li",null,{"children":["$","$L11",null,{"href":"/#","title":"instagram","className":"instagram","children":["$","i",null,{"className":"lab la-instagram"}]}]}],["$","li",null,{"children":["$","$L11",null,{"href":"/#","title":"pinterest","className":"pinterest","children":["$","i",null,{"className":"lab la-pinterest-p"}]}]}]]}]}]]}],["$","div",null,{"className":"row","children":[["$","div",null,{"className":"col-lg-8","children":["$","div",null,{"className":"post-layout-content","children":[["$","div",null,{"className":"layout-thumb mb-30","children":["$","$L12",null,{"title":"CBS News Appoints Ombudsman With Expanded Role and Unique Background","src":"/images/cbs-news-ombudsman.webp","alt":"CBS News Appoints Ombudsman With Expanded Role and Unique Background","width":1200,"height":800,"priority":true,"style":{"width":"100%","height":"auto"}}]}],["$","div",null,{"children":[["$","p","0",{"className":"layout-desc","style":{"marginBottom":"1rem"},"children":"CBS announced earlier this week that Kenneth Weinstein has been appointed as the new ombudsman for CBS News.  In this role, Weinstein will be responsible for handling consumer complaints, ensuring accountability, and promoting transparency across the network, including providing investigative oversight.  While ombudsmen traditionally focus on editorial matters, Weinstein’s background and expertise extend beyond conventional journalism expectations, positioning him to address a broader range of accountability challenges.  Media experts note that CBS’s appointment of Weinstein reflects a commitment to embracing the full scope of the ombudsman role, particularly at a time when the rapid and constant flow of digital information has amplified public scrutiny of news organizations and their credibility.  \n\nWeinstein’s responsibilities include overseeing journalistic integrity, responding to audience concerns, and serving as an independent voice that can evaluate CBS News’s reporting and practices objectively."}],"$L13","$L14","$L15"]}],"$L16","$L17"]}]}],"$L18"]}]]}]}],"$L19"]}]}]]
