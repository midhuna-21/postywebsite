ildren":["$","$L12",null,{"title":"Trump’s Tariffs Impact U.S. Company Sales in China, Survey Finds","src":"/images/trump-tariffs-us-china.webp","alt":"Trump’s Tariffs Impact U.S. Company Sales in China, Survey Finds","width":1200,"height":800,"priority":true,"style":{"width":"100%","height":"auto"}}]}],["$","div",null,{"children":[["$","p","0",{"className":"layout-desc","style":{"marginBottom":"1rem"},"children":"A recent study of U. S.  businesses operating in China indicates that many companies expect a decline in sales this year due to tariffs imposed during President Trump’s administration, as well as retaliatory tariffs enacted by China on U. S.  goods.  Survey responses highlight broader challenges that multinational companies face amid trade tensions between the world’s two largest economies, revealing the complex environment in which businesses must navigate geopolitical risks."}],["$","p","1",{"className":"layout-desc","style":{"marginBottom":"1rem"},"children":"$13"}],"$L14","$L15"]}],"$L16","$L17"]}]}],"$L18"]}]]}]}],"$L19"]}]}]]
