13:T49a,Italian luxury sports carmaker Ferrari raised its 2025 guidance on Thursday in the face of global 15% tariffs on foreign car imports to the United States as the company unveiled the new powertrain and chassis of its first fully electric production vehicle.  Yet the debut of its electric vehicle was marred by the company’s worst trading day since going public in 2016.  Industry analysts had expected much greater long-term growth and shares plunged 15% on the Milan Stock Exchange and about the same on the New York Stock Exchange.  Ferrari CEO Benedetto Vigna declined to give target production numbers or a price for the Ferrari Elettrica, which will be delivered beginning late next year, with the design to be revealed in the spring.  Under the carmaker’s new five-year plan, 40% of the product lineup will be the brand’s core internal combustion engines, 40% will be hybrid and 20% will be electric by 2030, with an average of four new launches a year in the period.  The new business plan calls for more models with lower volumes of each.  That signals a sharp reduction in the number of fully electric vehicles the company said it would build just a few yeas ago.4:[["$","$Lf",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"NewsArticle\",\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://www.pressorahub.com/business/ferrari-unveils-elettrica-ev-shares-fall/\"},\"headline\":\"Ferrari reveals features of first fully electric vehicle, but its financial outlook mars the debut\",\"description\":\"Ferrari raised its 2025 revenue guidance and unveiled the powertrain and chassis for its first fully electric vehicle, the Ferrari Elettrica, but shares plunged 15% after investors reacted to conservative growth forecasts and limited EV production plans.\",\"image\":\"/images/ferrari-elettrica-debut.webp\",\"author\":{\"@type\":\"Person\",\"name\":\"Lauren Jacobs\",\"url\":\"https://www.pressorahub.com/our-team/\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"PressoraHub\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://www.pressorahub.com/images/pressorahub-icon.webp\"}},\"datePublished\":\"2025-06-18T00:00:00.000Z\",\"dateModified\":\"2025-06-18T00:00:00.000Z\"}"}}],["$","$L10",null,{"breadcrumbTitle":"Ferrari reveals features of first fully electric vehicle, but its financial outlook mars the debut","category":"business","children":["$","div",null,{"children":[["$","section",null,{"className":"post-layout-1 padding","children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"top-content","children":[["$","div",null,{"className":"post-card single-card","children":["$","div",null,{"className":"post-content","children":[["$","$L11",null,{"title":"ferrari-unveils-elettrica-ev-shares-fall","href":"/business","className":"card-btn bg-green","children":"business"}],["$","h1",null,{"className":"title","style":{"lineHeight":1.3},"children":"Ferrari reveals features of first fully electric vehicle, but its financial outlook mars the debut"}],["$","ul",null,{"className":"post-list","children":[["$","li",null,{"className":"author","children":["by ",["$","span",null,{"children":"Lauren Jacobs"}]]}],["$","li",null,{"className":"date","children":"October 9, 2025"}]]}],["$","p",null,{"children":"Ferrari raised its 2025 revenue guidance and unveiled the powertrain and chassis for its first fully electric vehicle, the Ferrari Elettrica, but shares plunged 15% after investors reacted to conservative growth forecasts and limited EV production plans."}]]}]}],["$","div",null,{"className":"post-social","children":["$","ul",null,{"className":"social-list d-flex align-items-center","children":[["$","li",null,{}],["$","li",null,{"children":["$","$L11",null,{"href":"https://www.instagram.com/laur.enjacobs001/","className":"instagram","title":"instagram","children":["$","i",null,{"className":"lab la-instagram"}]}]}],["$","li",null,{"children":["$","$L11",null,{"href":"https://medium.com/@lauren_jacobs","className":"","style":{"border":""},"children":["$","i",null,{"className":"lab la-medium"}]}]}],["$","li",null,{"children":["$","$L11",null,{"href":"https://substack.com/@laurenjacobs672308","className":"pinterest","children":["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":"20","height":"15","viewBox":"0 0 256 256","children":["$","g",null,{"transform":"scale(5.12,5.12)","children":[["$","path",null,{"d":"M43,11h-35v-6h35z"}],["$","path",null,{"d":"M43,19h-35v-6h35z"}],["$","path",null,{"d":"M43,44.805l-17.016,-10.636l-17.984,10.579v-23.748h35z"}]]}]}]}]}]]}]}]]}],["$","div",null,{"className":"row","children":[["$","div",null,{"className":"col-lg-8","children":["$","div",null,{"className":"post-layout-content","children":[["$","div",null,{"className":"layout-thumb mb-30","children":["$","$L12",null,{"title":"Ferrari reveals features of first fully electric vehicle, but its financial outlook mars the debut","src":"/images/ferrari-elettrica-debut.webp","alt":"Ferrari reveals features of first fully electric vehicle, but its financial outlook mars the debut","width":1200,"height":800,"priority":true,"style":{"width":"100%","height":"auto"}}]}],["$","div",null,{"children":[["$","p","0",{"className":"layout-desc","style":{"marginBottom":"1rem"},"children":"$13"}],"$L14","$L15","$L16"]}],"$L17","$L18"]}]}],"$L19"]}]]}]}],"$L1a"]}]}]]
1b:I[9382,["206","static/chunks/5e22fd23-2e1f3144b2571522.js","894","static/chunks/894-e002e1fad4e8fb0b.js","687","static/chunks/687-98b0209c565be232.js","457","static/chunks/457-46e1a49bd71efb62.js","393","static/chunks/393-bbec8ed9f6b3db8a.js","413","static/chunks/app/%5Bcategory%5D/%5Bslug%5D/page-9c1829008c93d746.js"],"default"]
